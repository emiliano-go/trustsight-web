# Cloudflare injects its Web Analytics beacon into the HTML at the edge, and
# the zone has Web Analytics on. script-src and connect-src allow that one
# origin so the beacon runs instead of failing on every page load under the
# strict policy. If Web Analytics is turned off in the dashboard, drop both
# hosts: the site itself ships no third-party script.

/*
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=0, must-revalidate
  Vary: Accept
  Link: </.well-known/api-catalog>; rel="api-catalog", </.well-known/ai-catalog.json>; rel="ai-catalog", <https://docs.trustsight.org/>; rel="service-doc", </auth.md>; rel="describedby"; type="text/markdown"
  Content-Security-Policy: default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'self'; style-src 'self'; font-src 'self'; script-src 'self' 'sha256-NaQVBzp+6EVAIvtZSuA6rOcSdqSHgsRgoBPoTXjDjSg=' https://static.cloudflareinsights.com; connect-src 'self' https://watcher.trustsight.org https://cloudflareinsights.com

/.well-known/api-catalog
  Content-Type: application/linkset+json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600, must-revalidate

/.well-known/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/mcp/server-card
  Content-Type: application/mcp-server-card+json; charset=utf-8
  Access-Control-Allow-Origin: *

/mcp
  Access-Control-Allow-Methods: POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type, MCP-Protocol-Version
  Cache-Control: no-store

/auth.md
  Content-Type: text/markdown; charset=utf-8

/index.md
  Content-Type: text/markdown; charset=utf-8

/.well-known/mcp/server-card.json
  Content-Type: application/json; charset=utf-8

/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=86400, must-revalidate

/*.svg
  Cache-Control: public, max-age=86400, must-revalidate
