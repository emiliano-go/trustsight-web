{
  "name": "trustsight-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:csp && npm run verify:seo && vite build && vite build --ssr src/entry-server.jsx --outDir dist/server --emptyOutDir false && node scripts/prerender.mjs && node scripts/verify-prerender.mjs",
    "preview": "vite preview",
    "generate:seo": "python scripts/generate_seo.py",
    "verify:seo": "python scripts/generate_seo.py --check",
    "verify:csp": "node scripts/verify-csp.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:budget": "node scripts/verify-budget.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "lightningcss": "1.33.0",
    "preact": "10.29.8",
    "preact-render-to-string": "6.7.0",
    "terser": "5.50.0",
    "vite": "8.2.1"
  }
}
